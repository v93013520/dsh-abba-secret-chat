{
  "name": "dsh-abba-secret-chat",
  "version": "0.2.0",
  "description": "AB-BA 秘密对话：装进 DeepSeek Harness 右侧栏的一次性双人密码聊天，端到端加密（服务器只见密文），支持图片与截屏、我/你标签，结束即彻底清理。 · One-off two-person password chat for DeepSeek Harness: end-to-end encrypted, docked in the right sidebar, images/screenshots, cleared on end.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "chat",
    "secret-chat",
    "privacy",
    "e2e",
    "encryption",
    "lan",
    "two-person",
    "sidebar",
    "abba"
  ],
  "license": "MIT",
  "author": "wangwei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v93013520/dsh-abba-secret-chat.git"
  },
  "homepage": "https://github.com/v93013520/dsh-abba-secret-chat#readme",
  "bugs": {
    "url": "https://github.com/v93013520/dsh-abba-secret-chat/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  }
}
